---
/** Inline stroke icons used by design A (decorative: always aria-hidden). */
interface Props {
  name: 'download' | 'code' | 'briefcase' | 'mail' | 'play' | 'send' | 'close' | 'lock' | 'chevron-left' | 'chevron-right';
  size?: number;
  class?: string;
}
const { name, size = 18, class: className } = Astro.props;
const paths: Record<Props['name'], string> = {
  download: '<path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 21h14"/>',
  code: '<path d="m8 7-5 5 5 5"/><path d="m16 7 5 5-5 5"/>',
  briefcase: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"/>',
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>',
  play: '<path d="m6 4 14 8-14 8z"/>',
  send: '<path d="m4 12 16-8-6 16-2-6z"/>',
  close: '<path d="M6 6l12 12"/><path d="M18 6 6 18"/>',
  lock: '<rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
  'chevron-left': '<path d="m15 6-6 6 6 6"/>',
  'chevron-right': '<path d="m9 6 6 6-6 6"/>',
};
---

<svg
  class:list={['icon', className]}
  aria-hidden="true"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={paths[name]}
/>
